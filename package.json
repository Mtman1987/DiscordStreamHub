{
  "name": "nextn",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "patch:spmt-service-oauth": "node scripts/patch-mtfixit-service-oauth.mjs && node scripts/patch-spmt-platform-service-oauth.mjs",
    "patch:runtime-recovery": "node scripts/patch-linking-channel-recovery.mjs",
    "patch:chatgpt-approval": "node scripts/patch-chatgpt-handoff-approval.mjs",
    "predev": "node scripts/patch-signal-shoutout.mjs && npm run patch:spmt-service-oauth && npm run patch:runtime-recovery && npm run patch:chatgpt-approval",
    "dev": "next dev",
    "discord-ingress-bot": "tsx scripts/discord-ingress-bot.ts",
    "watch-voice-bot": "tsx scripts/watch-voice-bot.ts",
    "watch-mtfixit-twitch": "tsx scripts/watch-mtfixit-twitch.ts",
    "register-activity-command": "tsx scripts/register-activity-command.ts",
    "prebuild": "node scripts/patch-signal-shoutout.mjs && npm run patch:spmt-service-oauth && npm run patch:runtime-recovery && npm run patch:chatgpt-approval",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint . --ignore-pattern '.next/**' --ignore-pattern 'node_modules/**'",
    "typecheck": "npm run patch:spmt-service-oauth && npm run patch:runtime-recovery && npm run patch:chatgpt-approval && tsc --noEmit",
    "test:athena-gate": "node --import tsx --test tests/athena-visitor-gate.test.ts",
    "test:mtfixit": "npm run patch:spmt-service-oauth && npm run patch:chatgpt-approval && node --import tsx --test tests/mtfixit-contract.test.ts tests/chatgpt-handoff-approval.test.ts",
    "test:spmt-identity": "npm run patch:spmt-service-oauth && node --import tsx --test tests/spmt-points-identity.test.ts",
    "test:contracts": "node --import tsx --test tests/tenant-contracts.test.ts tests/spmt-onboarding-contract.test.ts tests/signal-carrier-roster.test.ts tests/linking-channel-recovery.test.ts",
    "test:applications": "node --experimental-strip-types --test tests/application-flow.test.ts"
  },
