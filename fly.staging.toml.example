# Copy this file to a local staging config name, then replace every placeholder
# before deploying. Do not point staging at production Discord/Twitch credentials
# or the production mounted volume.

app = 'discord-stream-hub-staging'
primary_region = 'iad'

[build]
  dockerfile = 'Dockerfile'
  [build.args]
    NEXT_PUBLIC_TWITCH_CLIENT_ID = 'STAGING_TWITCH_CLIENT_ID'
    NEXT_PUBLIC_APP_URL = 'https://discord-stream-hub-staging.fly.dev'
    NEXT_PUBLIC_BASE_URL = 'https://discord-stream-hub-staging.fly.dev'
    NEXT_PUBLIC_DISCORD_CLIENT_ID = 'STAGING_DISCORD_CLIENT_ID'
    NEXT_PUBLIC_HARDCODED_GUILD_ID = 'STAGING_DISCORD_TEST_GUILD_ID'
    NEXT_PUBLIC_HARDCODED_ADMIN_DISCORD_ID = 'STAGING_ADMIN_DISCORD_ID'
    NEXT_PUBLIC_HARDCODED_ADMIN_TWITCH_ID = 'STAGING_ADMIN_TWITCH_ID'

[env]
  NODE_ENV = 'production'
  DISABLE_STARTUP_SERVICES = 'true'

[[mounts]]
  source = 'discord_stream_staging_data'
  destination = '/data'
  initial_size = '10gb'

[http_service]
  internal_port = 3000
  force_https = true
  auto_stop_machines = 'off'
  auto_start_machines = true
  min_machines_running = 1

  [[http_service.checks]]
    interval = '30s'
    timeout = '10s'
    grace_period = '60s'
    method = 'GET'
    path = '/api/health'

[[vm]]
  memory = '2gb'
  cpu_kind = 'shared'
  cpus = 2

